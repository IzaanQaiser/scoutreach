    {
      "id": "EX7hrRtTEfgZRLWZRWI2U",
      "type": "text",
      "x": -877.3220352022961,
      "y": -45.49325114263786,
      "width": 956.38330078125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 647336893,
      "version": 1618,
      "versionNonce": 1515402450,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775744103433,
      "link": null,
      "locked": false,
      "text": "MVP Idea: A bot/tool that scrapes the YC companies directory for select batches, uses AI tools to research each company\nand produce a dossier for them. The user is given a tinder-style feed showing the dossier for each company + the founder(s). If the\nuser doesn't like the company (left swipe) then the company is added to the rejections list. If the user likes the company (right swipe)\nthen the company is added to the matches list. All companies that are in the matches list will have their dossier in a template + \nadditional information regarding the company reviewed, and all that information + the information that the tool knows about the\nuser (resume, work experience, portfolio, etc), is given to an AI to produce a cold email to send to the founder(s) to get whatever\nthe user was looking to get. All outreach activity is logged to a tracker (company, founder, platform, date sent, current status)\nso the user can monitor replies and follow up at the right time.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MVP Idea: A bot/tool that scrapes the YC companies directory for select batches, uses AI tools to research each company\nand produce a dossier for them. The user is given a tinder-style feed showing the dossier for each company + the founder(s). If the\nuser doesn't like the company (left swipe) then the company is added to the rejections list. If the user likes the company (right swipe)\nthen the company is added to the matches list. All companies that are in the matches list will have their dossier in a template + \nadditional information regarding the company reviewed, and all that information + the information that the tool knows about the\nuser (resume, work experience, portfolio, etc), is given to an AI to produce a cold email to send to the founder(s) to get whatever\nthe user was looking to get. All outreach activity is logged to a tracker (company, founder, platform, date sent, current status)\nso the user can monitor replies and follow up at the right time.",
      "autoResize": true,
      "lineHeight": 1.25
    },
